<Window x:Class="PatientAppointmentManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Patient Appointment Manager" Height="780" Width="1250"
 MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen"
 Background="#F3F6F8">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#142B35">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,24,18,28">
     <TextBlock Text="PATIENT" Foreground="White" FontSize="21" FontWeight="Bold"/>
     <TextBlock Text="APPOINTMENT MANAGER" Foreground="#9BB8BE" FontSize="10" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel>
     <Button x:Name="BrowserTabButton" Content="🌐  Trình duyệt" Click="BrowserTab_Click" Style="{StaticResource NavButton}"/>
     <Button x:Name="AddTabButton" Content="＋  Thêm lịch" Click="AddTab_Click" Style="{StaticResource NavButton}"/>
     <Button x:Name="ListTabButton" Content="▦  Lịch đã hẹn" Click="ListTab_Click" Style="{StaticResource NavButton}"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Dữ liệu lưu trên máy tính" Foreground="#9BB8BE" FontSize="10" Margin="18,16"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26">
   <Grid x:Name="BrowserView" Visibility="Visible">
    <StackPanel>
     <TextBlock Text="Trình duyệt bệnh viện" FontSize="26" FontWeight="SemiBold" Foreground="#18333D"/>
     <TextBlock Text="Nhập địa chỉ website khi đã có. Trình duyệt tích hợp sẽ được kết nối ở bước tiếp theo." Foreground="#637780" Margin="0,6,0,18"/>
     <DockPanel Margin="0,0,0,12">
      <Button Content="Mở" Width="76" DockPanel.Dock="Right" Click="OpenUrl_Click"/>
      <TextBox x:Name="UrlBox" Height="36" Padding="10" Text="https://"/>
     </DockPanel>
     <Border Background="White" CornerRadius="10" BorderBrush="#DCE5E8" BorderThickness="1" Padding="22" Height="520">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock Text="🌐" FontSize="42" HorizontalAlignment="Center"/>
       <TextBlock Text="Khu vực trình duyệt tích hợp" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,5"/>
       <TextBlock Text="Bản v0.1 đang dựng phần lõi. Bộ máy Chromium và bộ đọc dữ liệu website sẽ được tích hợp sau khi xác định môi trường triển khai." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="650" Foreground="#637780"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
   <Grid x:Name="AddView" Visibility="Collapsed">
    <StackPanel>
     <TextBlock Text="Thêm lịch hẹn" FontSize="26" FontWeight="SemiBold" Foreground="#18333D"/>
     <TextBlock Text="Có thể nhập thử dữ liệu giả để kiểm tra quy trình. Chưa kết nối website bệnh viện." Foreground="#637780" Margin="0,6,0,20"/>
     <Border Background="White" CornerRadius="10" Padding="22">
      <StackPanel>
       <TextBlock Text="Thông tin bệnh nhân" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,12,10"><TextBlock Text="Mã bệnh nhân"/><TextBox x:Name="PatientCodeBox" Height="34" Padding="8"/></StackPanel>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="Tên bệnh nhân"/><TextBox x:Name="PatientNameBox" Height="34" Padding="8"/></StackPanel>
        <StackPanel Margin="0,0,12,10"><TextBlock Text="Mã chỉ định (nếu có)"/><TextBox x:Name="ExamCodeBox" Height="34" Padding="8"/></StackPanel>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="Tên dịch vụ"/><TextBox x:Name="ServiceBox" Height="34" Padding="8" Text="Chụp CLVT"/></StackPanel>
       </UniformGrid>
       <Separator Margin="0,8,0,16"/>
       <TextBlock Text="Thời gian hẹn" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,12,0"><TextBlock Text="Ngày hẹn"/><DatePicker x:Name="AppointmentDatePicker" Height="34"/></StackPanel>
        <StackPanel><TextBlock Text="Buổi hẹn"/><ComboBox x:Name="ShiftBox" Height="34"><ComboBoxItem Content="Sáng" IsSelected="True"/><ComboBoxItem Content="Chiều"/></ComboBox></StackPanel>
       </UniformGrid>
       <Button Content="Xác nhận thêm lịch" Height="42" Width="190" HorizontalAlignment="Left" Margin="0,22,0,0" Background="#147D78" Foreground="White" FontWeight="SemiBold" Click="AddAppointment_Click"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
   <Grid x:Name="ListView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <TextBlock Text="Lịch đã hẹn" FontSize="26" FontWeight="SemiBold" Foreground="#18333D"/>
     <TextBlock Text="Tra cứu, lọc và kiểm soát số ca đã xếp lịch." Foreground="#637780" Margin="0,6,0,18"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="Bộ lọc" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <UniformGrid Columns="3">
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Từ ngày"/><DatePicker x:Name="FromDatePicker" Height="34"/></StackPanel>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToDatePicker" Height="34"/></StackPanel>
       <StackPanel><TextBlock Text="Buổi"/><ComboBox x:Name="FilterShiftBox" Height="34" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Cả ngày" IsSelected="True"/><ComboBoxItem Content="Sáng"/><ComboBoxItem Content="Chiều"/></ComboBox></StackPanel>
      </UniformGrid>
      <CheckBox x:Name="IncludeReturnedCheck" Content="Hiển thị cả lịch đã trả" Margin="0,12,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
      <Button Content="Áp dụng bộ lọc" Width="145" Height="34" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Refresh_Click"/>
     </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="#E5F2F0" CornerRadius="9" Padding="16" Margin="0,0,0,14">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="Tổng số ca trong danh sách: " FontWeight="SemiBold" Foreground="#24514D"/>
      <TextBlock x:Name="CountText" Text="0 ca" FontWeight="Bold" Foreground="#147D78" FontSize="17"/>
     </StackPanel>
    </Border>
    <DataGrid x:Name="AppointmentsGrid" Grid.Row="3" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Background="White" BorderBrush="#DCE5E8" HeadersVisibility="Column" RowHeight="34"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
     <Button Content="Trả lịch đã chọn" Width="145" Height="36" Background="#A43D3D" Foreground="White" Click="ReturnAppointment_Click"/>
     <Button Content="Làm mới" Width="100" Height="36" Margin="10,0,0,0" Click="Refresh_Click"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
