<Window x:Class="PatientAppointmentManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
 Title="Sổ hẹn CT"
 Height="800"
 Width="1300"
 MinHeight="680"
 MinWidth="850"
 WindowStartupLocation="CenterScreen"
 Background="#EAF3F4" Language="vi-VN">

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="SidebarColumn" Width="64"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- SIDEBAR: trình duyệt/quét danh sách và lịch đã hẹn -->
  <Border x:Name="Sidebar" Grid.Column="0" Background="#153D49">
   <StackPanel Margin="7,18,7,0">
    <StackPanel.Resources>
     <Style x:Key="SidebarIconButton" TargetType="Button">
      <Setter Property="Width" Value="50"/><Setter Property="Height" Value="54"/>
      <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="2"/>
      <Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#167D7D"/><Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6E8E8"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
       <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style>
    </StackPanel.Resources>
    <Button x:Name="AddNavButton" Content="🌐" ToolTip="Trình duyệt và quét danh sách" Click="AddTab_Click" Style="{StaticResource SidebarIconButton}"/>
    <Button x:Name="ListNavButton" Content="▦" ToolTip="Lịch đã hẹn" Click="ListTab_Click" Style="{StaticResource SidebarIconButton}" FontSize="32"/>
    <Button x:Name="SettingsNavButton" Content="⚙" ToolTip="Cài đặt" Click="SettingsTab_Click" Style="{StaticResource SidebarIconButton}" FontSize="27"/>
   </StackPanel>
  </Border>

  <Grid x:Name="MainContentPanel" Grid.Column="1" Margin="20">
   <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4FAFA" Offset="0"/><GradientStop Color="#E6F1F2" Offset="1"/></LinearGradientBrush></Grid.Background>

   <!-- TRÌNH DUYỆT NHIỀU THẺ VÀ NHẬP LỊCH -->
   <Grid x:Name="AddView" Visibility="Visible">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
     <TextBlock Text="Trình duyệt và quét danh sách"
                FontSize="21"
                FontWeight="Bold"
                Foreground="#18333D"/>
    </StackPanel>

    <Grid Grid.Row="1" MinHeight="300">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <DockPanel Grid.Row="0" Height="40" Margin="0,0,0,8" LastChildFill="True" VerticalAlignment="Center">
      <Button Content="Mở" Width="52" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Right" Click="AddOpenUrl_Click"/>
      <Button Content="Quét DS" ToolTip="Quét và đối chiếu danh sách chỉ định với lịch đã lưu" Width="72" Height="32" Padding="3,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,5,0" DockPanel.Dock="Right" Click="ScanHospitalList_Click"/>
     <Button Width="36" Height="34" Padding="0" Margin="0,0,5,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" DockPanel.Dock="Right" ToolTip="Vừa màn hình" Click="AddBrowserFit_Click">
      <TextBlock Text="⛶" FontSize="23" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Center" LineHeight="24"/>
     </Button>
     <Button Width="36" Height="34" Padding="0" Margin="0,0,4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" DockPanel.Dock="Right" ToolTip="Phóng to trang" Click="AddBrowserZoomIn_Click">
      <Grid Width="25" Height="25">
       <Ellipse Width="16" Height="16" Stroke="#17434B" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
       <Path Data="M 14,14 L 23,23" Stroke="#17434B" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
       <TextBlock Text="+" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,0,0,0"/>
      </Grid>
     </Button>
     <Button Width="36" Height="34" Padding="0" Margin="0,0,5,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" DockPanel.Dock="Right" ToolTip="Thu nhỏ trang" Click="AddBrowserZoomOut_Click">
      <Grid Width="25" Height="25">
       <Ellipse Width="16" Height="16" Stroke="#17434B" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
       <Path Data="M 14,14 L 23,23" Stroke="#17434B" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
       <TextBlock Text="−" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,0,0,0"/>
      </Grid>
     </Button>
      <ComboBox x:Name="AddUrlBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                KeyDown="AddUrlBox_KeyDown" GotKeyboardFocus="AddUrlBox_GotKeyboardFocus" Height="32" VerticalAlignment="Center" Padding="7" VerticalContentAlignment="Center">
       <ComboBox.ItemContainerStyle>
        <Style TargetType="ComboBoxItem">
         <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryItem_MouseLeftButtonUp"/>
        </Style>
       </ComboBox.ItemContainerStyle>
      </ComboBox>
     </DockPanel>

     <Border Grid.Row="1"
             Background="White"
             CornerRadius="15"
             BorderBrush="#D5E7E8"
             BorderThickness="1"
             ClipToBounds="True">
      <Grid>
       <TabControl x:Name="BrowserTabsControl" Margin="0,0,44,0" SelectionChanged="BrowserTabsControl_SelectionChanged">
        <TabItem x:Name="FirstBrowserTab">
         <cef:ChromiumWebBrowser x:Name="AddHospitalBrowser" Address="about:blank"/>
        </TabItem>
       </TabControl>
       <Button Content="＋" ToolTip="Mở tab mới" Width="34" Height="27"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"
               Padding="0" FontSize="19" Click="NewBrowserTab_Click" Panel.ZIndex="2"/>
      </Grid>
     </Border>
    </Grid>

    <Expander Grid.Row="2"
              Header="Nhập thủ công (mở khi cần)"
              IsExpanded="False"
              Margin="0,10,0,0"
              Background="#F8FCFC"
              Padding="10">
     <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
      <Border Background="#F8FCFC" CornerRadius="13" Padding="14">
       <StackPanel>
        <TextBlock Text="NHẬP LỊCH THỦ CÔNG"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#18333D"
                   Margin="0,0,0,10"/>

       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,12,10">
         <TextBlock Text="Mã bệnh nhân *"/>
         <TextBox x:Name="PatientCodeBox" Height="34" Padding="8"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
         <TextBlock Text="Tên bệnh nhân *"/>
         <TextBox x:Name="PatientNameBox" Height="34" Padding="8"/>
        </StackPanel>

        <StackPanel Margin="0,0,12,10">
         <TextBlock Text="Khoa phòng *"/>
         <TextBox x:Name="DepartmentBox" Height="34" Padding="8"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
         <TextBlock Text="Mã chỉ định"/>
         <TextBox x:Name="ExamCodeBox" Height="34" Padding="8"/>
        </StackPanel>

        <StackPanel Margin="0,0,12,10">
         <TextBlock Text="Tiêm thuốc cản quang"/>
         <ComboBox x:Name="InjectionStatusBox" Height="34" SelectedIndex="2">
          <ComboBoxItem Content="Không tiêm"/>
          <ComboBoxItem Content="Có tiêm"/>
          <ComboBoxItem Content="Chưa xác định"/>
         </ComboBox>
        </StackPanel>

        <StackPanel Margin="0,0,12,10">
         <TextBlock Text="Tên dịch vụ"/>
         <TextBox x:Name="ServiceBox" Height="34" Padding="8" Text="Chụp CLVT"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
         <TextBlock Text="Ngày hẹn"/>
         <DockPanel LastChildFill="True">
         <Button Content="−" Width="30" Height="34" Margin="0,0,5,0" Padding="0"
                 ToolTip="Lùi một ngày" Click="AppointmentDateMinus_Click"/>
         <Button Content="+" Width="30" Height="34" Margin="5,0,0,0" Padding="0"
                 ToolTip="Tiến một ngày" DockPanel.Dock="Right" Click="AppointmentDatePlus_Click"/>
         <DatePicker x:Name="AppointmentDatePicker" Height="34"/>
        </DockPanel>
        </StackPanel>
       </UniformGrid>

       <StackPanel Margin="0,0,0,8">
        <TextBlock Text="Buổi hẹn"/>
        <ComboBox x:Name="ShiftBox"
                  Height="34"
                  Width="180"
                  HorizontalAlignment="Left">
         <ComboBoxItem Content="Sáng" IsSelected="True"/>
         <ComboBoxItem Content="Chiều"/>
        </ComboBox>
       </StackPanel>

       <Button Content="XÁC NHẬN THÊM LỊCH"
               Height="42"
               Width="220"
               HorizontalAlignment="Left"
               Margin="0,12,0,0"
               Background="#147D78"
               Foreground="White"
               FontWeight="SemiBold"
               Click="AddAppointment_Click"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
    </Expander>
   </Grid>

   <!-- LỊCH ĐÃ HẸN -->
   <Grid x:Name="ListView" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
     <TextBlock Text="Lịch đã hẹn"
                FontSize="25"
                FontWeight="Bold"
                Foreground="#18333D"/>
     <TextBlock Text="Tra cứu, lọc và kiểm soát số ca đã xếp lịch."
                Foreground="#637780"
                Margin="0,6,0,18"/>
    </StackPanel>

    <Border Grid.Row="1"
            Background="White"
            CornerRadius="16"
            BorderBrush="#D7E8E9" BorderThickness="1"
            Padding="16"
            Margin="0,0,0,14">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
       <TextBlock Text="Từ ngày" FontSize="12" Margin="0,0,0,3"/>
       <DockPanel LastChildFill="True">
        <Button Content="−" Width="25" Height="30" Margin="0,0,3,0" Padding="0" ToolTip="Lùi một ngày" Click="FromDateMinus_Click"/>
        <Button Content="+" Width="25" Height="30" Margin="3,0,0,0" Padding="0" DockPanel.Dock="Right" ToolTip="Tiến một ngày" Click="FromDatePlus_Click"/>
        <DatePicker x:Name="FromDatePicker" Language="vi-VN" Height="30" SelectedDateChanged="FilterSelection_Changed"/>
       </DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
       <TextBlock Text="Đến ngày" FontSize="12" Margin="0,0,0,3"/>
       <DockPanel LastChildFill="True">
        <Button Content="−" Width="25" Height="30" Margin="0,0,3,0" Padding="0" ToolTip="Lùi một ngày" Click="ToDateMinus_Click"/>
        <Button Content="+" Width="25" Height="30" Margin="3,0,0,0" Padding="0" DockPanel.Dock="Right" ToolTip="Tiến một ngày" Click="ToDatePlus_Click"/>
        <DatePicker x:Name="ToDatePicker" Language="vi-VN" Height="30" SelectedDateChanged="FilterSelection_Changed"/>
       </DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,8,0">
       <TextBlock Text="Buổi" FontSize="12" Margin="0,0,0,3"/>
       <ComboBox x:Name="FilterShiftBox" Height="30" SelectionChanged="FilterSelection_Changed">
        <ComboBoxItem Content="Cả ngày" IsSelected="True"/><ComboBoxItem Content="Sáng"/><ComboBoxItem Content="Chiều"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="3">
       <TextBlock Text="Tiêm thuốc cản quang" FontSize="12" Margin="0,0,0,3"/>
       <ComboBox x:Name="InjectionFilterBox" Height="30" SelectionChanged="FilterSelection_Changed">
        <ComboBoxItem Content="Tất cả" IsSelected="True"/><ComboBoxItem Content="Có tiêm"/><ComboBoxItem Content="Không tiêm"/><ComboBoxItem Content="Chưa xác định"/>
       </ComboBox>
      </StackPanel>
      <CheckBox Grid.Row="1" Grid.ColumnSpan="4" x:Name="IncludeReturnedCheck" Content="Hiển thị cả lịch đã trả" Margin="0,8,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
     </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="#DDEFEF"
            CornerRadius="14"
            Padding="16"
            Margin="0,0,0,14">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,12,0">
       <TextBlock Text="TỔNG SỐ CA" FontSize="11" FontWeight="SemiBold" Foreground="#526C70"/>
       <TextBlock x:Name="TotalCountText" Text="0 ca" FontSize="22" FontWeight="Bold" Foreground="#24514D"/>
       <WrapPanel Margin="0,5,0,0">
        <TextBlock Text="Có tiêm: " Foreground="#526C70" FontSize="12"/>
        <TextBlock x:Name="TotalInjectionCountText" Text="0" FontWeight="SemiBold" Foreground="#24514D" FontSize="12"/>
        <TextBlock Text="   Không tiêm: " Foreground="#526C70" FontSize="12" Margin="12,0,0,0"/>
        <TextBlock x:Name="TotalNoInjectionCountText" Text="0" FontWeight="SemiBold" Foreground="#24514D" FontSize="12"/>
       </WrapPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="12,0,0,0">
       <TextBlock Text="SỐ CA CÒN HẸN" FontSize="11" FontWeight="SemiBold" Foreground="#526C70"/>
       <TextBlock x:Name="ActiveCountText" Text="0 ca" FontSize="22" FontWeight="Bold" Foreground="#147D78"/>
       <WrapPanel Margin="0,5,0,0">
        <TextBlock Text="Có tiêm: " Foreground="#526C70" FontSize="12"/>
        <TextBlock x:Name="ActiveInjectionCountText" Text="0" FontWeight="SemiBold" Foreground="#147D78" FontSize="12"/>
        <TextBlock Text="   Không tiêm: " Foreground="#526C70" FontSize="12" Margin="12,0,0,0"/>
        <TextBlock x:Name="ActiveNoInjectionCountText" Text="0" FontWeight="SemiBold" Foreground="#147D78" FontSize="12"/>
       </WrapPanel>
      </StackPanel>
     </Grid>
    </Border>

    <DataGrid x:Name="AppointmentsGrid" LoadingRow="AppointmentsGrid_LoadingRow" Sorting="AppointmentsGrid_Sorting"
              Grid.Row="3"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              Background="White"
              BorderBrush="#DCE5E8"
              HeadersVisibility="Column"
              RowHeight="34" FontSize="13.5"/>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
     <Button Content="Trả lịch đã chọn"
             Width="145"
             Height="36"
             Background="#A43D3D"
             Foreground="White"
             Click="ReturnAppointment_Click"/>

     <Button Content="Xóa lịch đã chọn"
             Width="130"
             Height="36"
             Margin="10,0,0,0"
             Background="#A43D3D"
             Foreground="White"
             Click="DeleteSelectedAppointment_Click"/>
     <Button Content="Làm mới"
             Width="100"
             Height="36"
             Margin="10,0,0,0"
             Click="Refresh_Click"/>
    </StackPanel>
   </Grid>

   <!-- CÀI ĐẶT -->
   <Grid x:Name="SettingsView" Visibility="Collapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="Cài đặt" FontSize="25" FontWeight="Bold" Foreground="#18333D" Margin="0,0,0,16"/>
      <Border Background="White" BorderBrush="#D7E8E9" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="Hiệu năng" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Chọn cấu hình sẽ được áp dụng sau khi khởi động lại phần mềm." Foreground="#637780" Margin="0,0,0,8"/>
        <ComboBox x:Name="PerformanceModeBox" Width="260" Height="34" HorizontalAlignment="Left" SelectedIndex="2">
         <ComboBoxItem Content="Cấu hình cao"/>
         <ComboBoxItem Content="Cấu hình trung bình"/>
         <ComboBoxItem Content="Cấu hình thấp"/>
        </ComboBox>
        <Button Content="Lưu cấu hình" Width="140" Height="36" HorizontalAlignment="Left" Margin="0,10,0,0" Click="SaveSettings_Click"/>
        <TextBlock x:Name="SettingsStatusText" Foreground="#637780" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#D7E8E9" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="Sao lưu và khôi phục dữ liệu" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Bản sao lưu chứa dữ liệu lịch hẹn và được lưu trong thư mục Backups." Foreground="#637780" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <WrapPanel>
         <Button Content="Sao lưu dữ liệu ngay" Width="160" Height="36" Margin="0,0,8,0" Click="BackupDatabase_Click"/>
         <Button Content="Khôi phục từ file" Width="145" Height="36" Margin="0,0,8,0" Click="RestoreDatabase_Click"/>
         <Button Content="Mở thư mục dữ liệu" Width="150" Height="36" Click="OpenDataFolder_Click"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#D7E8E9" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="Sao lưu đám mây Google Drive" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Đăng nhập bằng tài khoản Google Drive chung. Ứng dụng chỉ xin quyền quản lý các tệp do SoHenBN tạo." Foreground="#637780" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <WrapPanel>
         <Button Content="Kết nối / đăng nhập Google" Width="210" Height="36" Margin="0,0,8,8" Click="ConnectGoogleDrive_Click"/>
         <Button Content="Sao lưu Drive ngay" Width="150" Height="36" Margin="0,0,8,8" Click="CloudBackupNow_Click"/>
        </WrapPanel>
        <TextBlock x:Name="GoogleDriveStatusText" Text="Chưa kết nối Google Drive." Foreground="#637780" TextWrapping="Wrap" Margin="0,4,0,6"/>
        <TextBlock Text="Lịch tự động: 16:30 mỗi ngày khi phần mềm đang chạy. Chỉ tải lên khi cơ sở dữ liệu thay đổi. Lưu tối đa 30 bản ngày, 12 bản tuần và 12 bản tháng." Foreground="#637780" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#D7E8E9" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="Xóa lịch hẹn" FontSize="18" FontWeight="Bold" Foreground="#A43D3D" Margin="0,0,0,8"/>
        <TextBlock Text="Mỗi thao tác xóa sẽ tự sao lưu cơ sở dữ liệu trước khi thực hiện. Chỉ xóa bản ghi lịch hẹn, không xóa hồ sơ bệnh nhân." TextWrapping="Wrap" Foreground="#637780" Margin="0,0,0,10"/>
        <TextBlock Text="Xóa theo khoảng ngày" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,5,0,8">
         <StackPanel Margin="0,0,12,0"><TextBlock Text="Từ ngày" FontSize="12"/><DatePicker x:Name="DeleteFromDatePicker" Width="150" SelectedDateFormat="Short"/></StackPanel>
         <StackPanel><TextBlock Text="Đến ngày" FontSize="12"/><DatePicker x:Name="DeleteToDatePicker" Width="150" SelectedDateFormat="Short"/></StackPanel>
        </WrapPanel>
        <WrapPanel>
         <Button Content="Xóa lịch theo ngày" Width="150" Height="36" Margin="0,0,8,8" Background="#A43D3D" Foreground="White" Click="DeleteAppointmentsByDate_Click"/>
         <Button Content="Xóa lịch đã trả" Width="130" Height="36" Margin="0,0,8,8" Background="#A43D3D" Foreground="White" Click="DeleteReturnedAppointments_Click"/>
         <Button Content="Xóa toàn bộ lịch" Width="140" Height="36" Margin="0,0,8,8" Background="#8B2525" Foreground="White" Click="DeleteAllAppointments_Click"/>
        </WrapPanel>
        <TextBlock Text="Thao tác xóa không thể hoàn tác trực tiếp. Hãy giữ bản sao lưu ở nơi an toàn." Foreground="#A43D3D" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>
